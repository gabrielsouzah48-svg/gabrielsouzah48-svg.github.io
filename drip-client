<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0a0713">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>DRIP CLIENT PROXY — Free Fire Max</title>
<style>
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0;background:#0a0713}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
       color:#f2eefb;font-size:14px;line-height:1.25}
  .app{display:flex;flex-direction:column;width:100%;max-width:430px;margin:0 auto;
       min-height:100vh;background:#0a0713;position:relative;overflow:hidden}
  .status{display:flex;justify-content:space-between;align-items:center;
          padding:calc(8px + env(safe-area-inset-top)) 16px 4px;font-size:11px;
          color:#c9c2dd;letter-spacing:.3px}
  .sicons{display:flex;gap:5px;align-items:center}
  .head{display:flex;align-items:center;gap:10px;padding:8px 14px 12px}
  .logo{width:34px;height:34px;border-radius:10px;background:#1a1130;
        border:1px solid rgba(192,132,252,.35);display:flex;align-items:center;
        justify-content:center;flex:0 0 auto}
  .htitle{font-size:15px;font-weight:500;letter-spacing:.6px}
  .htitle b{color:#c084fc;font-weight:500}
  .hsub{font-size:9.5px;letter-spacing:2.4px;color:#8b5cf6;font-weight:500;margin-top:1px}
  .online{margin-left:auto;font-size:10.5px;color:#4ade80;display:flex;align-items:center;
          gap:5px;background:#0f1f16;border:1px solid rgba(74,222,128,.28);
          padding:4px 9px;border-radius:20px;white-space:nowrap}
  .dot{width:6px;height:6px;border-radius:50%;background:#4ade80}
  .tabs{display:flex;gap:6px;padding:0 14px 10px}
  .tabbtn{flex:1;background:#120c20;border:1px solid rgba(168,85,247,.14);color:#8b83a6;
          padding:8px 0;border-radius:9px;font-size:11px;letter-spacing:1.1px;
          font-weight:500;cursor:pointer;font-family:inherit}
  .tabbtn.on{background:#2a1150;border-color:rgba(192,132,252,.5);color:#e9d5ff}
  .body{padding:0 14px 8px;flex:1}
  .sec{font-size:10.5px;letter-spacing:1.8px;color:#8b83a6;display:flex;align-items:center;
       gap:7px;margin:12px 0 8px;font-weight:500}
  .card{background:#130d22;border:1px solid rgba(168,85,247,.13);border-radius:13px;padding:11px 13px}
  .row{display:flex;align-items:center;gap:10px;background:#130d22;
       border:1px solid rgba(168,85,247,.13);border-radius:13px;padding:11px 13px;margin-bottom:8px}
  .rtxt{flex:1;min-width:0}
  .rname{font-size:13px;font-weight:500;color:#efe9fb}
  .rdesc{font-size:11px;color:#7d7694;margin-top:2px}
  .sw{width:42px;height:23px;border-radius:12px;background:#241a3c;
      border:1px solid rgba(168,85,247,.18);position:relative;cursor:pointer;
      flex:0 0 auto;padding:0}
  .sw i{position:absolute;top:2px;left:2px;width:17px;height:17px;border-radius:50%;
        background:#6b6383;transition:left .16s ease,background .16s ease;display:block}
  .sw.on{background:#3b1178;border-color:rgba(192,132,252,.55)}
  .sw.on i{left:21px;background:#e9d5ff}
  .sw.locked{cursor:default}
  .rd{width:22px;height:22px;border-radius:50%;border:2px solid #352b52;
      background:transparent;cursor:pointer;flex:0 0 auto;padding:0;display:flex;
      align-items:center;justify-content:center}
  .rd i{width:10px;height:10px;border-radius:50%;background:transparent;display:block}
  .rd.on{border-color:#c084fc}
  .rd.on i{background:#c084fc}
  .pgame{display:flex;align-items:center;gap:11px}
  .picon{width:38px;height:38px;border-radius:11px;background:#1a1130;
         border:1px solid rgba(168,85,247,.2);display:flex;align-items:center;
         justify-content:center;flex:0 0 auto}
  .pname{font-size:13.5px;font-weight:500}
  .pver{font-size:10.5px;color:#7d7694;margin-top:2px;letter-spacing:.4px}
  .max{font-size:9px;background:#a020f0;color:#fff;padding:1.5px 6px;border-radius:5px;
       letter-spacing:.9px;margin-left:5px;vertical-align:1px;font-weight:500}
  .pill{font-size:9.5px;color:#4ade80;border:1px solid rgba(74,222,128,.3);
        background:#0f1f16;padding:3px 8px;border-radius:20px;margin-left:auto;letter-spacing:.6px}
  .btn{width:100%;margin-top:11px;border:0;border-radius:11px;padding:13px 0;font-size:13.5px;
       font-weight:500;letter-spacing:2px;color:#fff;background:#a020f0;cursor:pointer;
       font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px}
  .btn.armed{background:#b91c1c}
  .btn.busy{opacity:.72;cursor:default}
  .log{margin-top:12px;background:#0c0817;border:1px solid rgba(168,85,247,.13);
       border-radius:12px;padding:9px 11px;font-family:ui-monospace,SFMono-Regular,Menlo,
       Consolas,monospace;font-size:10.5px;color:#8f86ad;min-height:100px}
  .log div{margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .log .t{color:#5f5878}
  .log .ok{color:#4ade80}
  .log .hl{color:#c084fc}
  .nav{display:flex;border-top:1px solid rgba(168,85,247,.14);background:#0c0817;
       padding-bottom:env(safe-area-inset-bottom);margin-top:14px}
  .navbtn{flex:1;background:transparent;border:0;padding:11px 0 13px;color:#6b6383;
          font-size:10px;letter-spacing:1.2px;cursor:pointer;font-family:inherit;
          display:flex;flex-direction:column;align-items:center;gap:5px}
  .navbtn.on{color:#c084fc}
  .toast{position:absolute;left:50%;transform:translateX(-50%);bottom:78px;
         background:#241a3c;border:1px solid rgba(192,132,252,.45);color:#f3e8ff;
         font-size:11.5px;padding:8px 14px;border-radius:20px;opacity:0;
         transition:opacity .2s;pointer-events:none;white-space:nowrap}
  .toast.show{opacity:1}
  .hint{font-size:10px;color:#6b6383;text-align:center;padding:0 14px 12px;letter-spacing:.3px}
  @media (min-width:600px){
    body{background:#07050f;padding:26px 0}
    .app{min-height:auto;border-radius:26px;border:1px solid rgba(168,85,247,.25)}
    .status{padding-top:8px}
  }
</style>
</head>
<body>
<div class="app">
  <div class="status">
    <span id="clk">15:52</span>
    <div class="sicons">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c9c2dd" stroke-width="2"><path d="M12 3a9 9 0 1 0 9 9"/><path d="M12 3v9h9"/></svg>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c9c2dd" stroke-width="2"><path d="M5 12.5 12 5l7 7.5"/><path d="M8 12.5 12 8.5l4 4"/></svg>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c9c2dd" stroke-width="2"><rect x="6" y="4" width="12" height="16" rx="2"/><path d="M10 19h4"/></svg>
    </div>
  </div>

  <div class="head">
    <div class="logo">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="#e879f9"><path d="M12 2.5c3.2 4 6 7.1 6 10.4a6 6 0 0 1-12 0c0-3.3 2.8-6.4 6-10.4z"/></svg>
    </div>
    <div>
      <div class="htitle">DRIP <b>CLIENT</b></div>
      <div class="hsub">PROXY</div>
    </div>
    <div class="online"><span class="dot"></span><span id="stTxt">Online</span></div>
  </div>

  <div id="panelGames">
    <div class="tabs">
      <button class="tabbtn" data-tab="func">FUNÇÕES</button>
      <button class="tabbtn" data-tab="proxy">PROXY MENU</button>
    </div>

    <div class="body">
      <div id="tabFunc">
        <div class="sec">ESCUDO ANTI-BAN</div>
        <div class="row">
          <div class="rtxt"><div class="rname">Anti-ban total</div><div class="rdesc">Injeção externa, sem tocar na memória.</div></div>
          <button class="sw on locked" data-k="antiban"><i></i></button>
        </div>
        <div class="row">
          <div class="rtxt"><div class="rname">Bypass de HWID</div><div class="rdesc">Esconde o serial do aparelho.</div></div>
          <button class="sw on" data-k="hwid"><i></i></button>
        </div>
        <div class="row">
          <div class="rtxt"><div class="rname">Modo fantasma</div><div class="rdesc">Não deixa rastro nos logs da Garena.</div></div>
          <button class="sw on" data-k="ghost"><i></i></button>
        </div>
        <div class="row">
          <div class="rtxt"><div class="rname">Limpar cache ao remover</div><div class="rdesc">Zera arquivos temporários ao sair.</div></div>
          <button class="sw" data-k="clearcache"><i></i></button>
        </div>
      </div>

      <div id="tabProxy">
        <div class="sec">HEAD SHOT</div>
        <div class="row">
          <div class="rtxt"><div class="rname">Precisão</div><div class="rdesc">HS que faz a mira não passar.</div></div>
          <button class="sw on" data-k="precisa"><i></i></button>
        </div>
        <div class="row">
          <div class="rtxt"><div class="rname">HS Alto</div><div class="rdesc">HS acima da cabeça.</div></div>
          <button class="rd" data-hs="alto"><i></i></button>
        </div>
        <div class="row">
          <div class="rtxt"><div class="rname">HS Alto + Neck</div><div class="rdesc">HS alto com pescoço.</div></div>
          <button class="rd" data-hs="altoneck"><i></i></button>
        </div>
        <div class="row">
          <div class="rtxt"><div class="rname">HS Caveira</div><div class="rdesc">HS abaixo do pescoço.</div></div>
          <button class="rd" data-hs="caveira"><i></i></button>
        </div>
        <div class="row">
          <div class="rtxt"><div class="rname">HS Neck</div><div class="rdesc">HS pescoço legit.</div></div>
          <button class="rd" data-hs="neck"><i></i></button>
        </div>

        <div class="sec">PLAYER</div>
        <div class="card">
          <div class="pgame">
            <div class="picon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#fb923c"><path d="M12 2c1 3.5-2 4-2 7a4 4 0 0 0 8 0c0-1.3-.6-2.2-1.4-3 .2 1.4-.5 2.3-1.3 2.6.6-2.6-.9-5.4-3.3-6.6z"/><path d="M6.5 12.5A5.5 5.5 0 0 0 12 21a5.5 5.5 0 0 0 5.5-8.5A6.5 6.5 0 0 1 12 15a6.5 6.5 0 0 1-5.5-2.5z"/></svg>
            </div>
            <div>
              <div class="pname">Free Fire<span class="max">MAX</span></div>
              <div class="pver">1.123.1</div>
            </div>
            <div class="pill" id="pPill" style="display:none">● ATIVO</div>
          </div>
          <button class="btn" id="inject"></button>
        </div>

        <div class="log" id="log"></div>
      </div>
    </div>
  </div>

  <div id="panelSettings" style="display:none">
    <div class="body">
      <div class="sec">SETTINGS</div>
      <div class="row"><div class="rtxt"><div class="rname">Tema escuro</div><div class="rdesc">Interface do client.</div></div><button class="sw on"><i></i></button></div>
      <div class="row"><div class="rtxt"><div class="rname">Boost de FPS</div><div class="rdesc">Libera taxa de quadros no Max.</div></div><button class="sw on"><i></i></button></div>
      <div class="row"><div class="rtxt"><div class="rname">Som de injeção</div><div class="rdesc">Aviso ao injetar e remover.</div></div><button class="sw"><i></i></button></div>
      <div class="row"><div class="rtxt"><div class="rname">Idioma</div><div class="rdesc">Português (BR).</div></div><span style="font-size:11px;color:#7d7694">PT-BR</span></div>
      <div class="hint" style="padding-top:14px">DRIP CLIENT v4.2 · proxy ativo · ping <span id="ping">38</span>ms</div>
    </div>
  </div>

  <div class="nav">
    <button class="navbtn on" data-nav="games">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="7" width="20" height="11" rx="4"/><path d="M7 12h3M8.5 10.5v3M15.5 11.5h.01M17.5 13.5h.01"/></svg>
      GAMES
    </button>
    <button class="navbtn" data-nav="settings">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v2.4M12 18.8v2.4M4.2 7.2l2 1.2M17.8 15.6l2 1.2M4.2 16.8l2-1.2M17.8 8.4l2-1.2"/></svg>
      SETTINGS
    </button>
  </div>

  <div class="toast" id="toast"></div>
</div>

<script>
const KEY='drip_ffmax_v1';
let S=JSON.parse(localStorage.getItem(KEY)||'null')||{nav:'games',tab:'proxy',precisa:true,hs:null,antiban:true,hwid:true,ghost:true,clearcache:false,inject:false};
let busy=false;
const $=s=>document.querySelector(s),$$=s=>document.querySelectorAll(s);
const save=()=>localStorage.setItem(KEY,JSON.stringify(S));
const wait=ms=>new Promise(r=>setTimeout(r,ms));
const LOCK='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>';
const UNLOCK='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 7.6-1.6"/></svg>';

const LOG=[];
function log(msg,cls){
  const d=new Date();
  const t=String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')+':'+String(d.getSeconds()).padStart(2,'0');
  LOG.push({t,msg,cls}); if(LOG.length>7)LOG.shift(); paintLog();
}
function paintLog(){
  $('#log').innerHTML=LOG.map(l=>'<div><span class="t">['+l.t+']</span> <span class="'+(l.cls||'')+'">'+l.msg+'</span></div>').join('')||'<div><span class="t">[--:--:--]</span> aguardando...</div>';
}
let tt;
function toast(m){const e=$('#toast');e.textContent=m;e.classList.add('show');clearTimeout(tt);tt=setTimeout(()=>e.classList.remove('show'),1700);}

function render(){
  $$('.tabbtn').forEach(b=>b.classList.toggle('on',b.dataset.tab===S.tab));
  $$('.navbtn').forEach(b=>b.classList.toggle('on',b.dataset.nav===S.nav));
  $('#tabFunc').style.display=(S.nav==='games'&&S.tab==='func')?'block':'none';
  $('#tabProxy').style.display=(S.nav==='games'&&S.tab==='proxy')?'block':'none';
  $('#panelGames').style.display=(S.nav==='games')?'block':'none';
  $('#panelSettings').style.display=(S.nav==='settings')?'block':'none';
  $$('.sw').forEach(b=>{const k=b.dataset.k; if(k)b.classList.toggle('on',!!S[k]);});
  $$('.rd').forEach(b=>b.classList.toggle('on',S.hs===b.dataset.hs));
  const btn=$('#inject');
  if(!busy){btn.innerHTML=S.inject?UNLOCK+'REMOVER':LOCK+'INJETAR';btn.classList.toggle('armed',S.inject);}
  $('#pPill').style.display=S.inject?'block':'none';
  $('#stTxt').textContent=S.inject?'Injetado':'Online';
}

document.addEventListener('click',e=>{
  const t=e.target.closest('button'); if(!t)return;
  if(t.dataset.tab){S.tab=t.dataset.tab;save();render();}
  if(t.dataset.nav){S.nav=t.dataset.nav;save();render();}
  if(t.dataset.k&&!t.classList.contains('locked')){S[t.dataset.k]=!S[t.dataset.k];save();render();}
  if(t.dataset.hs){S.hs=S.hs===t.dataset.hs?null:t.dataset.hs;save();render();}
});

$('#inject').addEventListener('click',async()=>{
  if(busy)return; busy=true; const btn=$('#inject'); btn.classList.add('busy');
  if(!S.inject){
    btn.textContent='INJETANDO...';
    log('Abrindo Free Fire Max 1.123.1...');
    await wait(500); log('Conectando proxy DRIP...','hl');
    await wait(500); log('Anti-ban ativo · bypass de HWID ok','ok');
    await wait(450); log('Injeção concluída. Bom jogo!','ok');
    S.inject=true; toast('Injetado no Free Fire Max');
  }else{
    btn.textContent='REMOVENDO...';
    log('Removendo injeção...','hl');
    await wait(500); log('Restaurando processo original...');
    await wait(500); log('Cache limpo · jogo 100% limpo','ok');
    S.inject=false; toast('Injeção removida');
  }
  busy=false; btn.classList.remove('busy'); save(); render();
});

(function tick(){
  const d=new Date();
  $('#clk').textContent=String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');
  $('#ping').textContent=34+Math.floor(Math.random()*12);
  setTimeout(tick,1000);
})();

log('DRIP CLIENT PROXY iniciado','hl');
log('Proxy conectado · região BR','ok');
log('Aguardando injeção...');
render();
</script>
</body>
</html>
